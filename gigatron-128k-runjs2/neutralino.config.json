{
  "applicationId": "com.gigatron.emulator.neutralino",
  "applicationName": "Gigatron 128K",
  "applicationVersion": "1.0.0",
  "description": "Gigatron 128K 模拟器 - 基于 Neutralinojs 的轻量级桌面应用",
  "url": "/resources/index_128k.html",
  "port": 0,
  "loadNativeResource": true,
  "enableServer": true,
  "enableNativeAPI": true,
  "tokenSecurity": "none",
  "nativeAllowList": [
    "app.*",
    "os.*",
    "filesystem.*",
    "window.*",
    "debug.log"
  ],
  "globalVariables": {
    "TEST": "Hello World"
  },
  "modes": {
    "window": {
      "title": "Gigatron 128K 模拟器",
      "width": 900,
      "height": 750,
      "minWidth": 800,
      "minHeight": 650,
      "fullScreen": false,
      "alwaysOnTop": false,
      "icon": "/resources/favicon.ico",
      "enableInspector": false,
      "borderless": false,
      "maximize": true,
      "hidden": false,
      "resizable": true,
      "center": true
    },
    "browser": {
      "nativeBlockOpenExternalLinks": false
    },
    "cloud": {
      "enableRemoteModule": false
    }
  },
  "cli": {
    "binaryName": "gigatron-128k",
    "resourcesPath": "/resources/",
    "extensionsPath": "/extensions/",
    "clientLibrary": "/resources/neutralino.js",
    "binaryVersion": "6.3.0",
    "clientVersion": "6.3.0"
  },
  "files": [
    {
      "src": "/html/**/*",
      "dest": "/resources/"
    },
    {
      "src": "/roms/**/*",
      "dest": "/resources/"
    },
    {
      "src": "/gt1/**/*",
      "dest": "/resources/"
    },
    {
      "src": "/resources/**/*",
      "dest": "/resources/"
    },
    {
      "src": "/sd.vhd",
      "dest": "/resources/"
    },
    {
      "src": "/dev128k.rom",
      "dest": "/resources/"
    },
    {
      "src": "/favicon.ico",
      "dest": "/resources/"
    }
  ],
  "buildPath": "./dist/",
  "extensions": []
}